cmd_init() {
    local tasks_file=""
    local things_project=""
    local populate=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --populate) populate=true; shift ;;
            -*) echo "Unknown option: $1" >&2; exit 1 ;;
            *)
                if [ -z "$tasks_file" ]; then
                    tasks_file="$1"
                else
                    things_project="$1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$tasks_file" ] || [ -z "$things_project" ]; then
        json_response "false" "Usage: things init <tasks.md> <Things-project> [--populate]"
        exit 1
    fi

    if [ -f "$tasks_file" ]; then
        json_response "false" "File already exists: $tasks_file"
        exit 1
    fi

    # Get project name for header
    local project_name=$(basename "$(dirname "$tasks_file")")
    [ "$project_name" = "." ] && project_name=$(basename "$things_project")

    # Capitalize first letter (bash 3 compatible)
    local first_char=$(echo "${project_name:0:1}" | tr '[:lower:]' '[:upper:]')
    local rest="${project_name:1}"
    project_name="${first_char}${rest}"

    # Create directory if needed
    mkdir -p "$(dirname "$tasks_file")"

    # Generate tasks.md content
    local content="# Tasks - ${project_name}

**Synkad med:** Things 3 → $things_project
**Senast synkad:** $(date +%Y-%m-%d)

---

## Väntar på externa

---

## Att göra

---

## Utveckling

---

## Klart

"

    echo "$content" > "$tasks_file"

    # Populate with existing todos if requested
    if [ "$populate" = true ]; then
        echo "Populating from Things..."
        cmd_sync "$tasks_file" "$things_project"
    else
        json_response "true" "Created $tasks_file linked to $things_project"
    fi
}

# =============================================================================
# SYNC COMMAND (Bidirectional)
# =============================================================================

cmd_sync() {
    local tasks_file=""
    local things_project=""
    local dry_run=false
    local auto_yes=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            -y|--yes) auto_yes=true; shift ;;
            -*) echo "Unknown option: $1" >&2; exit 1 ;;
            *)
                if [ -z "$tasks_file" ]; then
                    tasks_file="$1"
                else
                    things_project="$1"
                fi
                shift
                ;;
        esac
    done

    if [ -z "$tasks_file" ] || [ -z "$things_project" ]; then
        json_response "false" "Usage: things sync <tasks.md> <Things-project> [--dry-run] [-y]"
        exit 1
    fi

    if [ ! -f "$tasks_file" ]; then
        json_response "false" "File not found: $tasks_file"
        exit 1
    fi

    # Get auth token for updates
    local auth_token=$(get_auth_token)

    # Get todos from Things
    local things_result
    things_result=$(cmd_todo_list "$things_project" 2>/dev/null) || {
        json_response "false" "Could not read Things project: $things_project"
        exit 1
    }

    # Use Python for robust bidirectional sync logic
    local dry_run_py="False"
    [ "$dry_run" = true ] && dry_run_py="True"
    local auto_yes_py="False"
    [ "$auto_yes" = true ] && auto_yes_py="True"

    # Run sync and capture update commands
    local sync_output
    sync_output=$(python3 - "$things_result" "$tasks_file" "$dry_run_py" "$auto_yes_py" << 'PYTHON_SYNC'
import json
import re
import sys
from pathlib import Path
from datetime import date

things_result = sys.argv[1]
tasks_file_path = sys.argv[2]
dry_run = sys.argv[3] == "True"
auto_yes = sys.argv[4] == "True"

# Load Things data
things_data = json.loads(things_result).get('data', [])

# Build Things lookup by ID
things_by_id = {t['id']: t for t in things_data}
things_by_title = {}
for t in things_data:
    normalized = t['name'].strip().lower()
    things_by_title[normalized] = t

# Read tasks.md
tasks_file = Path(tasks_file_path)
content = tasks_file.read_text()
lines = content.split('\n')

# Parse tasks.md with full field extraction
task_pattern = re.compile(r'^- \[([ x~])\] (.+)$')
things_id_pattern = re.compile(r'^\s+- things:([A-Za-z0-9_-]+)\s*$')
note_pattern = re.compile(r'^\s+- (.+)$')
tag_pattern = re.compile(r'`([^`]+)`')
deadline_pattern = re.compile(r'`deadline:(\d{4}-\d{2}-\d{2})`')
when_pattern = re.compile(r'`when:([^`]+)`')

def extract_md_notes(lines, start_idx, end_idx):
    """Extract notes from MD task, excluding things:ID line"""
    notes = []
    for i in range(start_idx, end_idx):
        line = lines[i]
        if line.startswith('  ') and not things_id_pattern.match(line):
            # Remove leading "  - " and add to notes
            note_text = re.sub(r'^\s+- ', '', line)
            if note_text.strip():
                notes.append(note_text.strip())
    return '\n'.join(notes)

def normalize_notes(notes):
    """Normalize notes for comparison"""
    if not notes:
        return ''
    # Remove extra whitespace, normalize newlines
    lines = [l.strip() for l in notes.split('\n') if l.strip()]
    return '\n'.join(lines)

# Section to Things mapping based on SKILL.md
SECTION_DEFAULTS = {
    'att göra': {'when': 'anytime', 'tag': None},
    'väntar på externa': {'when': 'someday', 'tag': 'väntar'},
    'blockerad': {'when': 'someday', 'tag': 'blockerad'},
    'idéer': {'when': 'someday', 'tag': 'idé'},
    'klart': {'when': None, 'tag': None},
}

def get_section_defaults(section_name):
    """Get Things defaults for a section"""
    if not section_name:
        return {'when': 'anytime', 'tag': None}
    normalized = section_name.strip().lower()
    for key, defaults in SECTION_DEFAULTS.items():
        if key in normalized:
            return defaults
    return {'when': 'anytime', 'tag': None}

md_tasks = []
i = 0
current_section = None

while i < len(lines):
    line = lines[i]

    # Track current section
    if line.startswith('## '):
        current_section = line[3:].strip()

    match = task_pattern.match(line)
    if match:
        status_char = match.group(1)
        rest = match.group(2)

        # Extract tags (excluding special tags)
        all_tags = tag_pattern.findall(rest)
        regular_tags = [t for t in all_tags if not t.startswith(('done:', 'deadline:', 'when:'))]

        # Extract deadline and when
        deadline_match = deadline_pattern.search(rest)
        when_match = when_pattern.search(rest)
        deadline = deadline_match.group(1) if deadline_match else ''
        when = when_match.group(1) if when_match else ''

        # Clean title
        title = tag_pattern.sub('', rest).strip()

        status = 'open' if status_char == ' ' else ('completed' if status_char == 'x' else 'in_progress')

        task = {
            'line_num': i,
            'status': status,
            'title': title,
            'tags': regular_tags,
            'deadline': deadline,
            'when': when,
            'things_id': None,
            'notes_start': None,
            'notes_end': None,
            'section': current_section,
        }

        j = i + 1
        task['notes_start'] = j
        while j < len(lines):
            subline = lines[j]
            if not subline.startswith('  '):
                break

            id_match = things_id_pattern.match(subline)
            if id_match:
                task['things_id'] = id_match.group(1)
            j += 1
        task['notes_end'] = j

        # Extract notes text
        task['notes'] = extract_md_notes(lines, task['notes_start'], task['notes_end'])

        md_tasks.append(task)
        i = j
    else:
        i += 1

# Bidirectional sync logic
diffs = []
things_updates = []  # Commands to update Things
md_updates = []  # Updates to apply to MD
new_in_md = []  # New tasks to add to MD

matched_things_ids = set()

for task in md_tasks:
    things_todo = None

    # Match by ID first, then by title
    if task['things_id']:
        things_todo = things_by_id.get(task['things_id'])
        if things_todo:

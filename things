cmd_show() {
    local identifier="${1:-today}"
    local filter=""

    shift 2>/dev/null || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --filter) filter="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local builtin_lists="inbox today anytime upcoming someday logbook tomorrow deadlines repeating all-projects logged-projects"
    local identifier_lower=$(echo "$identifier" | tr '[:upper:]' '[:lower:]')
    local is_builtin=false

    for list in $builtin_lists; do
        if [ "$identifier_lower" = "$list" ]; then
            is_builtin=true
            break
        fi
    done

    local url
    if [ "$is_builtin" = true ]; then
        url="things:///show?id=${identifier_lower}"
    elif [[ "$identifier" =~ ^[A-Za-z0-9_-]{20,}$ ]]; then
        url="things:///show?id=${identifier}"
    else
        url="things:///show?query=$(urlencode "$identifier")"
    fi

    [ -n "$filter" ] && url="${url}&filter=$(urlencode "$filter")"

    open "$url"
    sleep 0.3
    json_response "true" "Showing: $identifier"
}

cmd_search() {
    local query="${1:-}"

    if [ -n "$query" ]; then
        open "things:///search?query=$(urlencode "$query")"
    else
        open "things:///search"
    fi
    sleep 0.3
    json_response "true" "Opened search${query:+ for: $query}"
}


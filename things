#!/usr/bin/env bash
# Things 3 CLI - Unified interface for Things 3 on macOS
# Uses AppleScript for reading, URL scheme for writing
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AUTH_TOKEN_FILE="${SCRIPT_DIR}/auth-token"

# =============================================================================
# SHARED FUNCTIONS
# =============================================================================

urlencode() {
    python3 -c "import urllib.parse; print(urllib.parse.quote('''$1''', safe=''))"
}

get_auth_token() {
    if [ -n "${THINGS3_AUTH_TOKEN:-}" ]; then
        echo "$THINGS3_AUTH_TOKEN"
    elif [ -f "$AUTH_TOKEN_FILE" ]; then
        cat "$AUTH_TOKEN_FILE" | tr -d '[:space:]'
    else
        echo ""
    fi
}

json_response() {
    local success="$1"
    local message="$2"
    local data="${3:-null}"
    echo "{\"success\": $success, \"message\": \"$message\", \"data\": $data}"
}

lookup_todo_id() {
    local identifier="$1"
    # If it looks like an ID, use it directly
    if [[ "$identifier" =~ ^[A-Za-z0-9_-]{20,}$ ]]; then
        echo "$identifier"
        return 0
    fi
    # Otherwise look up by name
    osascript -e "tell application \"Things3\"
        try
            return id of to do \"$identifier\"
        on error
            set allTodos to to dos
            repeat with t in allTodos
                if name of t is \"$identifier\" then
                    return id of t
                end if
            end repeat
        end try
        return \"NOT_FOUND\"
    end tell" 2>/dev/null
}

# =============================================================================
# TODO COMMANDS
# =============================================================================

cmd_todo_add() {
    local title=""
    local notes="" when="" deadline="" tags="" list="" checklist="" reveal=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --notes) notes="$2"; shift 2 ;;
            --when) when="$2"; shift 2 ;;
            --deadline) deadline="$2"; shift 2 ;;
            --tags) tags="$2"; shift 2 ;;
            --list) list="$2"; shift 2 ;;
            --checklist) checklist="$2"; shift 2 ;;
            --reveal) reveal="true"; shift ;;
            -*) echo "Unknown option: $1" >&2; exit 1 ;;
            *) title="$1"; shift ;;
        esac
    done

    if [ -z "$title" ]; then
        json_response "false" "Title is required"
        exit 1
    fi

    # Build URL (URL scheme for creation to support list placement)
    local url="things:///add?title=$(urlencode "$title")"
    [ -n "$notes" ] && url="${url}&notes=$(urlencode "$notes")"
    [ -n "$when" ] && url="${url}&when=${when}"
    [ -n "$deadline" ] && url="${url}&deadline=${deadline}"
    [ -n "$tags" ] && url="${url}&tags=$(urlencode "$tags")"
    [ -n "$list" ] && url="${url}&list=$(urlencode "$list")"
    [ -n "$reveal" ] && url="${url}&reveal=true"

    if [ -n "$checklist" ]; then
        local items=$(echo "$checklist" | tr ',' '\n')
        url="${url}&checklist-items=$(urlencode "$items")"
    fi

    open "$url"
    sleep 0.3
    json_response "true" "To-do added" "{\"title\": \"$title\"}"
}

cmd_todo_list() {
    local list_name="${1:-Today}"

    local script="tell application \"Things3\"
        set output to \"[\"
        try
            set todoList to to dos of list \"$list_name\"
        on error
            try
                set todoList to to dos of project \"$list_name\"
            on error
                try
                    set todoList to to dos of area \"$list_name\"
                on error
                    return \"[]\"
                end try
            end try
        end try
        set todoCount to count of todoList
        repeat with i from 1 to todoCount
            set t to item i of todoList
            set todoId to id of t
            set todoName to name of t
            set todoNotes to notes of t
            set todoStatus to status of t as string
            set todoTags to tag names of t

            set todoScheduled to \"\"
            try
                set schedDate to activation date of t
                if schedDate is not missing value then
                    set todoScheduled to (year of schedDate) & \"-\" & (text -2 thru -1 of (\"0\" & ((month of schedDate) as integer))) & \"-\" & (text -2 thru -1 of (\"0\" & (day of schedDate)))
                end if
            end try

            set todoDue to \"\"
            try
                set dueDate to due date of t
                if dueDate is not missing value then
                    set todoDue to (year of dueDate) & \"-\" & (text -2 thru -1 of (\"0\" & ((month of dueDate) as integer))) & \"-\" & (text -2 thru -1 of (\"0\" & (day of dueDate)))
                end if
            end try

            -- Escape quotes
            set AppleScript's text item delimiters to \"\\\"\"
            set todoName to text items of todoName
            set AppleScript's text item delimiters to \"\\\\\\\"\"
            set todoName to todoName as string
            set AppleScript's text item delimiters to \"\\\"\"
            set todoNotes to text items of todoNotes
            set AppleScript's text item delimiters to \"\\\\\\\"\"
            set todoNotes to todoNotes as string
            set AppleScript's text item delimiters to \"\"

            -- Escape newlines
            set AppleScript's text item delimiters to ASCII character 10
            set todoNotes to text items of todoNotes
            set AppleScript's text item delimiters to \"\\\\n\"
            set todoNotes to todoNotes as string
            set AppleScript's text item delimiters to \"\"

            set output to output & \"{\\\"id\\\": \\\"\" & todoId & \"\\\", \\\"name\\\": \\\"\" & todoName & \"\\\", \\\"notes\\\": \\\"\" & todoNotes & \"\\\", \\\"status\\\": \\\"\" & todoStatus & \"\\\", \\\"tags\\\": \\\"\" & todoTags & \"\\\", \\\"when\\\": \\\"\" & todoScheduled & \"\\\", \\\"deadline\\\": \\\"\" & todoDue & \"\\\"}\"
            if i < todoCount then
                set output to output & \", \"
            end if
        end repeat
        set output to output & \"]\"
        return output
    end tell"

    local result
    result=$(osascript -e "$script" 2>&1) || {
        json_response "false" "AppleScript error: $result"
        exit 1
    }

    json_response "true" "Listed to-dos from $list_name" "$result"
}

cmd_todo_get() {
    local identifier="$1"
    if [ -z "$identifier" ]; then
        json_response "false" "To-do ID or name is required"
        exit 1
    fi

    local script="tell application \"Things3\"
        set t to missing value
        try
            set t to to do \"$identifier\"
        end try
        if t is missing value then
            try
                set t to to do id \"$identifier\"
            end try
        end if
        if t is missing value then
            set allTodos to to dos
            repeat with todo in allTodos
                if name of todo is \"$identifier\" then
                    set t to todo
                    exit repeat
                end if
            end repeat
        end if
        if t is missing value then
            return \"NOT_FOUND\"
        end if

        set todoId to id of t
        set todoName to name of t
        set todoNotes to notes of t
        set todoStatus to status of t as string
        set todoTags to tag names of t

        set todoDue to \"null\"
        try
            set d to due date of t
            if d is not missing value then
                set todoDue to \"\\\"\" & (year of d) & \"-\" & (text -2 thru -1 of (\"0\" & ((month of d) as integer))) & \"-\" & (text -2 thru -1 of (\"0\" & (day of d))) & \"\\\"\"
            end if
        end try

        set todoWhen to \"null\"
        try
            set w to activation date of t
            if w is not missing value then
                set todoWhen to \"\\\"\" & (year of w) & \"-\" & (text -2 thru -1 of (\"0\" & ((month of w) as integer))) & \"-\" & (text -2 thru -1 of (\"0\" & (day of w))) & \"\\\"\"
            end if
        end try

        set todoProject to \"null\"
        try
            set p to project of t
            if p is not missing value then
                set todoProject to \"\\\"\" & (name of p) & \"\\\"\"
            end if
        end try

        -- Escape quotes in name and notes
        set AppleScript's text item delimiters to \"\\\"\"
        set todoName to text items of todoName
        set AppleScript's text item delimiters to \"\\\\\\\"\"
        set todoName to todoName as string
        set AppleScript's text item delimiters to \"\\\"\"
        set todoNotes to text items of todoNotes
        set AppleScript's text item delimiters to \"\\\\\\\"\"
        set todoNotes to todoNotes as string
        set AppleScript's text item delimiters to \"\"

        -- Escape newlines
        set AppleScript's text item delimiters to ASCII character 10
        set todoNotes to text items of todoNotes
        set AppleScript's text item delimiters to \"\\\\n\"
        set todoNotes to todoNotes as string
        set AppleScript's text item delimiters to \"\"

        return \"{\\\"id\\\": \\\"\" & todoId & \"\\\", \\\"name\\\": \\\"\" & todoName & \"\\\", \\\"notes\\\": \\\"\" & todoNotes & \"\\\", \\\"status\\\": \\\"\" & todoStatus & \"\\\", \\\"tags\\\": \\\"\" & todoTags & \"\\\", \\\"deadline\\\": \" & todoDue & \", \\\"when\\\": \" & todoWhen & \", \\\"project\\\": \" & todoProject & \"}\"
    end tell"

    local result
    result=$(osascript -e "$script" 2>&1) || {
        json_response "false" "AppleScript error: $result"
        exit 1
    }

    if [ "$result" = "NOT_FOUND" ]; then
        json_response "false" "To-do not found: $identifier"
        exit 1
    fi

    json_response "true" "To-do found" "$result"
}

cmd_todo_update() {
    local identifier=""
    local title="" notes="" append_notes="" when="" deadline=""
    local tags="" add_tags="" list="" completed="" canceled="" reveal=""

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --title) title="$2"; shift 2 ;;
            --notes) notes="$2"; shift 2 ;;
            --append-notes) append_notes="$2"; shift 2 ;;
            --when) when="$2"; shift 2 ;;
            --deadline) deadline="$2"; shift 2 ;;
            --tags) tags="$2"; shift 2 ;;
            --add-tags) add_tags="$2"; shift 2 ;;
            --list) list="$2"; shift 2 ;;
            --completed) completed="true"; shift ;;
            --canceled) canceled="true"; shift ;;
            --reveal) reveal="true"; shift ;;
            -*) echo "Unknown option: $1" >&2; exit 1 ;;
            *) identifier="$1"; shift ;;
        esac
    done

    if [ -z "$identifier" ]; then
        json_response "false" "To-do ID or name is required"
        exit 1
    fi

    # Get auth token
    local auth_token=$(get_auth_token)
    if [ -z "$auth_token" ]; then
        json_response "false" "Auth token required for updates"
        exit 1
    fi

    # Look up ID if needed
    local task_id=$(lookup_todo_id "$identifier")
    if [ "$task_id" = "NOT_FOUND" ]; then
        json_response "false" "To-do not found: $identifier"
        exit 1
    fi

    # Build URL
    local url="things:///update?auth-token=${auth_token}&id=${task_id}"
    [ -n "$title" ] && url="${url}&title=$(urlencode "$title")"
    [ -n "$notes" ] && url="${url}&notes=$(urlencode "$notes")"
    [ -n "$append_notes" ] && url="${url}&append-notes=$(urlencode "$append_notes")"
    [ -n "$when" ] && url="${url}&when=${when}"
    [ -n "$deadline" ] && url="${url}&deadline=${deadline}"
    [ -n "$tags" ] && url="${url}&tags=$(urlencode "$tags")"
    [ -n "$add_tags" ] && url="${url}&add-tags=$(urlencode "$add_tags")"
    [ -n "$list" ] && url="${url}&list=$(urlencode "$list")"
    [ -n "$completed" ] && url="${url}&completed=true"
    [ -n "$canceled" ] && url="${url}&canceled=true"
    [ -n "$reveal" ] && url="${url}&reveal=true"

    open "$url"
    sleep 0.3
    json_response "true" "To-do updated" "{\"id\": \"$task_id\"}"
}

cmd_todo_complete() {
    local identifier="$1"
    if [ -z "$identifier" ]; then
        json_response "false" "To-do ID or name is required"
        exit 1
    fi
    cmd_todo_update "$identifier" --completed
}

